# Variáveis lidas pelo PRÓPRIO docker compose, para interpolar ${...} no bloco
# `environment:` do docker-compose.yml.
#
# NÃO confundir com o `.env` da raiz, que é carregado DENTRO dos containers via
# `env_file:`. Como `environment:` tem precedência sobre `env_file:`, uma
# variável interpolada aqui e ausente SOBRESCREVE COM VAZIO o que estiver no
# `.env` da raiz — em silêncio. Já mordeu uma vez neste projeto: o canal aberto
# do Discord ficou configurado na raiz e simplesmente não valia.
#
# Regra: variável usada em ${...} no compose  -> este arquivo
#        variável lida só pelo código Ruby    -> .env da raiz
#
# Copie para `docker/.env` e preencha o que precisar. Tudo aqui é opcional: os
# padrões abaixo são os mesmos que o docker-compose.yml aplica quando a
# variável não existe.
#
# Coberto pelo .gitignore (o padrão `.env` casa em qualquer nível).

# ── Imagem ───────────────────────────────────────────────────────────────────
# Tag das imagens próprias (app, jobs, discord-bot). Em deploy costuma ser os
# 12 primeiros caracteres do hash do commit.
IMAGE_TAG=latest

# ── Canal aberto do Discord ──────────────────────────────────────────────────
# IDs, separados por vírgula, dos canais onde o bot responde SEM menção e onde
# todos compartilham a MESMA conversa. Vazio = nenhum canal aberto, e o bot
# exige menção em todo lugar (o comportamento padrão).
# Para pegar o ID: ligue o Modo Desenvolvedor no Discord, clique com o botão
# direito no canal, "Copiar ID". Tem que ser canal de servidor — em DM não faz
# sentido, porque DM já responde sem menção e já é individual.
DISCORD_OPEN_CHANNEL_IDS=

# Prefixo que faz o bot IGNORAR a mensagem por completo no canal aberto — ela
# não gera resposta e nem entra no histórico. É a válvula para as pessoas
# conversarem entre si sem sair do canal.
DISCORD_MUTE_PREFIX=//

# ── Lista de conversas (/sessions, /resume, /delete) ─────────────────────────
# Quantas conversas o /sessions mostra por página. A numeração é CONTÍNUA entre
# páginas: a página 2 mostra 21, 22, 23. Faixa aceita: 1 a 100.
DISCORD_SESSIONS_PAGE_SIZE=20

# Teto de conversas que os comandos alcançam no total. É guarda de memória da
# consulta, não limite de uso.
DISCORD_SESSIONS_MAX=500

# ── Compactação de contexto ──────────────────────────────────────────────────
# Fração da janela do modelo que dispara a compactação. O gatilho é DUPLO: isto
# ou a contagem de mensagens vivas passar de DISCORD_REHYDRATE_MESSAGES, o que
# vier primeiro. O log diz qual dos dois disparou.
DISCORD_COMPACTION_THRESHOLD=0.75

# Quantas mensagens voltam ao contexto quando uma conversa é retomada ou o
# cache é despejado. Também é o gatilho por contagem da compactação.
DISCORD_REHYDRATE_MESSAGES=30

# Mensagens finais que NUNCA são compactadas. Contadas por quantidade, nunca
# por orçamento de token — por token, numa janela grande, protegeria tudo e a
# compactação nunca rodaria.
DISCORD_PROTECTED_TAIL=8

# ── Registro dos slash commands ──────────────────────────────────────────────
# Vazio = registro GLOBAL, que leva até 1 hora para propagar no Discord.
# Preenchido com o ID do servidor = registro por guild, instantâneo, mas os
# comandos passam a existir SÓ naquele servidor.
DISCORD_COMMAND_GUILD_ID=

# ── Cadeia de rotas do chat ──────────────────────────────────────────────────
# Esforco de raciocinio do elo Nous: none | low | medium | high.
DISCORD_EFFORT_NOUS=none
# Vazio = raciocinio desligado na rota direta da Poolside. `true` religa.
DISCORD_POOLSIDE_THINKING=
# Anexos de arquivo (.txt/.md/.pdf) no chat do Discord — interpolados no
# compose com default; ajuste aqui (N1: vivem neste arquivo, nao na .env raiz).
DISCORD_ATTACHMENT_MAX_BYTES=10485760      # Teto de download em bytes (default 10MB)
DISCORD_ATTACHMENT_MAX_CHARS=30000         # Teto de texto no frame (default 30k)
DISCORD_OUTPUT_CODE_LINES=25               # Linhas minimas em bloco de codigo para virar arquivo (default 25)
DISCORD_OUTPUT_PROSE_CHARS=4000            # Caracteres minimos em prosa para virar resposta.md (default 4000)

# ── Envs dedicados de container (docker/.env.sidecar e docker/.env.searxng) ──
# Os containers de MAIOR exposição (python-scraper e searxng) não carregam o
# .env da raiz — cada um tem env_file próprio, no padrão `.env.*` do gitignore:
#
#   docker/.env.sidecar   -> python-scraper (token obrigatório)
#   docker/.env.searxng   -> searxng (secret do settings.yml)
#
# Crie os dois à mão (copie de .env.sidecar.example / .env.searxng.example) com
# o MESMO valor usado no .env da raiz, quando houver:
#
#   PYTHON_SCRAPER_TOKEN=<token>          # igual ao PYTHON_SCRAPER_TOKEN da raiz
#   SEARXNG_SECRET_KEY=<secret>           # usada por !env no settings.yml
