# Copie para docker/.env.searxng (casa com .env.* do gitignore).
# Lida por !env SEARXNG_SECRET_KEY no docker/searxng/settings.yml.
# Gere com: openssl rand -hex 32
SEARXNG_SECRET_KEY=

# Key da Brave Search API (engine `braveapi` oficial, sem scraping).
# NAO e lida por !env (nao interpola na factory do searxng) — e injetada em
# runtime por docker/searxng-runtime/gerar-settings.sh, que substitui o
# placeholder __BRAVE_API_KEY__ em docker/searxng/settings.yml.
BRAVE_API_KEY=
