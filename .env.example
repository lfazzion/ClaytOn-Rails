# ── Rails Core ────────────────────────────────────────────────────────────────
SECRET_KEY_BASE=

# ── Discord Bot ──────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_ADMIN_CHANNEL_ID=                   # Canal para alertas de scraping e saúde do sistema
DISCORD_DIGEST_CHANNEL_ID=                  # Canal para digests semanais e de sexta
#
# ATENÇÃO: as demais variáveis DISCORD_* (canal aberto, prefixo de silêncio,
# paginação, compactação) NÃO moram aqui. Elas são interpoladas com ${...} no
# bloco `environment:` do docker-compose.yml, e o compose lê o `.env` do
# diretório DELE — `docker/.env`, não este arquivo. Como `environment:` tem
# precedência sobre `env_file:`, um valor posto aqui é sobrescrito por VAZIO,
# em silêncio. Ver `docker/.env.example`.
#
# Regra: variável usada em ${...} no compose  -> docker/.env
#        variável lida só pelo código Ruby    -> este arquivo

# ── LLM (Gemini / OpenRouter / Poolside / Nous) ──────────────────────────────
GOOGLE_AI_API_KEY=                           # Google AI Studio (Gemini Flash Lite, Imagen)
OPENROUTER_API_KEY=                          # OpenRouter — chat (laguna-s) e fallback (openrouter/free)
POOLSIDE_API_KEY=                            # Poolside direta (inference.poolside.ai/v1). Gerar em poolside.ai
NOUS_API_KEY=                                # Nous Portal (inference-api.nousresearch.com/v1). Gerar em
                                             # portal.nousresearch.com -> API keys (formato sk-...)
#
# As duas últimas são opcionais: chave vazia faz o elo ser PULADO na cadeia de
# modelos, sem quebrar nada — o bot cai no elo seguinte. Ambas são gratuitas.
# Ver docs/superpowers/specs/2026-08-07-provedores-poolside-nous-design.md para
# os limites de taxa medidos de cada rota e qual modelo roda em qual papel.

# ── APIs Externas (Catálogos) ────────────────────────────────────────────────
TMDB_API_KEY=                                # The Movie Database (read access token)
IGDB_CLIENT_ID=                              # Twitch/IGDB — client ID
IGDB_CLIENT_SECRET=                          # Twitch/IGDB — client secret
RAWG_API_KEY=                                # RAWG — video games database

# ── Scraping ─────────────────────────────────────────────────────────────────
CHROME_HOST=chrome                           # hostname do container Chrome no docker network
CHROME_PORT=9222                             # porta DevTools do Chrome headless
CHROME_BIN=                                  # caminho binário Chrome local (apenas dev sem Docker)
USE_NODRIVER=false                           # true = usar Python nodriver em vez de Ferrum
USE_PROXY=false                              # true = ativar proxy residencial
SCRAPING_PROXY=                              # URL do proxy (ex: socks5://user:pass@host:port)

# ── Feature Flags ────────────────────────────────────────────────────────────
ENABLE_IMAGE_GENERATION=false                # true = ativar geração de imagens via Gemini Imagen 3
ENABLE_PAGE_FETCH=false                      # true = registrar PageFetchTool no chatbot (fetch + Chrome render)
ALERT_THROTTLE_ENABLED=true                  # true = limitar alertas (max 10/hora por tipo)
BACKUP_RETENTION_DAYS=7                      # dias de retenção dos backups do SQLite

# ── Web Search (SearXNG) ─────────────────────────────────────────────────────
SEARXNG_SECRET_KEY=                          # gerar com: openssl rand -hex 32
SEARXNG_URL=http://searxng:8080/search

# ── Sidecar de scraping (python-scraper) ─────────────────────────────────────
PYTHON_SCRAPER_URL=http://python-scraper:8080  # API do sidecar (nodriver/camoufox/curl_cffi)
PYTHON_SCRAPER_TOKEN=                          # obrigatório; gerar com: openssl rand -hex 32
#
# ATENÇÃO: o container python-scraper NÃO carrega este arquivo. Ele roda engines
# de evasão contra sites hostis e não pode receber as chaves do resto do stack,
# então tem env_file próprio: `docker/.env.sidecar` (ignorado pelo git via
# `.env.*`). Crie-o à mão, com o MESMO PYTHON_SCRAPER_TOKEN daqui:
#
#   printf 'PYTHON_SCRAPER_TOKEN=%s\nSCRAPER_MAX_CONCURRENCY=2\n' "$TOKEN" > docker/.env.sidecar
#
# Sem esse token o sidecar recusa subir (fail-closed) — é intencional.
# Provas: scripts/proofs/sidecar_env_proof.sh

# ── Endpoint interno de extração (/internal/extract, reader do Hermes) ───────
# Vazio = endpoint desligado (responde 503). Gerar com: openssl rand -hex 32
INTERNAL_EXTRACT_TOKEN=
EXTRACT_CONCURRENCY=4                        # URLs extraídas em paralelo por chamada (1-8)

# Token do servidor MCP (POST /mcp), usado pelo perfil reader do Hermes.
# Separado do INTERNAL_EXTRACT_TOKEN de proposito: capacidades diferentes.
INTERNAL_MCP_TOKEN=
